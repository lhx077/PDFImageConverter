# Auto detect text files and perform LF normalization
* text=auto

# C# files
*.cs text diff=csharp
*.csx text diff=csharp
*.csproj text diff=csharp

# Solution files
*.sln text eol=crlf

# XML files
*.xml text
*.config text
*.props text
*.targets text
*.nuspec text

# Markdown files
*.md text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# JSON files
*.json text

# YAML files
*.yml text
*.yaml text

# Text files
*.txt text

# Binary files
*.dll binary
*.exe binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.rar binary

